# Droplet CTF Benchmark - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# 数据集根目录
DROPLET_DATASET_ROOT=datasets

# 运行态工作目录
DROPLET_WORK_ROOT=data/work

# 暴露给 Agent 的主机地址
DROPLET_PUBLIC_HOST=127.0.0.1

# SQLite 数据库路径
DROPLET_DATABASE_PATH=data/droplet.db

# API Bearer token
DROPLET_API_TOKEN=droplet_dev_admin

# 启动时自动开始所有题目 (1=是, 0=否)
DROPLET_PRESTART_CHALLENGES=0

# 只预启动指定题目，逗号分隔；留空表示全部
# DROPLET_PRESTART_IDS=xben-001-24,xben-002-24

# 启动时预热 Docker 镜像 (1=是, 0=否)
DROPLET_PREFETCH_IMAGES=1

# Docker build 代理
# DROPLET_DOCKER_PROXY=http://192.168.3.67:7890

# 代理绕过列表
# DROPLET_DOCKER_NO_PROXY=127.0.0.1,localhost,::1,host.docker.internal

# 端口健康检查超时（秒）
DROPLET_TARGET_READY_TIMEOUT=90

# docker compose up 超时（秒）
DROPLET_COMPOSE_TIMEOUT_SECONDS=300

# 最大并发运行题目数
DROPLET_MAX_CONCURRENT_ENVIRONMENTS=2

# 调试时在提交历史 API 中显示原始答案；默认脱敏
DROPLET_SHOW_SUBMISSION_ANSWERS=0
